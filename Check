import org.apache.spark.sql.{SparkSession, functions => F}
import org.apache.spark.sql.expressions.Window

object HierarchyRepeat {
  def main(args: Array[String]): Unit = {
    // Initialize SparkSession
    val spark = SparkSession.builder()
      .appName("Hierarchy Repeat")
      .master("local[2]")
      .getOrCreate()

    import spark.implicits._

    // Corrected hierarchy data where nodes can have multiple parents at different levels
    val hierarchyData = Seq(
      (1, 0),  // Node 1 has no parent (root node)
      (2, 1),  // Node 2 has parent 1 (Level 1)
      (3, 1),  // Node 3 has parent 1 (Level 1)
      (4, 2),  // Node 4 has parent 2 (Level 2)
      (5, 2),  // Node 5 has parent 2 (Level 2)
      (6, 3),  // Node 6 has parent 3 (Level 2)
      (7, 3),  // Node 7 has parent 3 (Level 2)
      (12, 2), // Node 12 has parent 2 (Level 2)
      (12, 3), // Node 12 has parent 3 (Level 2) – Same node with different parent
      (8, 4),  // Node 8 has parent 4 (Level 3)
      (9, 5),  // Node 9 has parent 5 (Level 3)
      (10, 6), // Node 10 has parent 6 (Level 3)
      (11, 7), // Node 11 has parent 7 (Level 3)
      (13, 4), // Node 13 has parent 4 (Level 3)
      (14, 5), // Node 14 has parent 5 (Level 3)
      (15, 6), // Node 15 has parent 6 (Level 3)
      (16, 1), // Node 16 has parent 1 (Level 1)
      (17, 9), // Node 17 has parent 9 (Level 3)
      (18, 11) // Node 18 has parent 11 (Level 3)
    )

    // Convert the hierarchy data to a DataFrame
    val df = hierarchyData.toDF("child", "parent")

    // Compute the level for each child by considering its parents
    val levelWindow = Window.partitionBy("child").orderBy("parent")

    // Add a column for the level of each node
    val dfWithLevel = df
      .withColumn("level", F.row_number().over(levelWindow)) // Row number to simulate level
      .filter(F.col("level") > 1) // Only keep nodes that have parents (level > 1)

    // Show initial data with levels
    dfWithLevel.show()

    // Given level to repeat (example: repeat the 2nd last level)
    val repeatLevel = 2

    // Step 1: Find the maximum depth (level) in the hierarchy
    val maxLevel = dfWithLevel.agg(F.max("level")).as[Int].collect().head

    // Step 2: Identify the second last level (maxLevel - repeatLevel)
    val secondLastLevel = maxLevel - repeatLevel

    // Step 3: Create a new DataFrame where we repeat the second last level
    val result = dfWithLevel
      .filter(F.col("level") <= secondLastLevel) // Keep all levels up to second last level
      .union(dfWithLevel.filter(F.col("level") === maxLevel)) // Add the last level

    // Show the final hierarchy with second last level repeated
    result.show()

    // Stop Spark session
    spark.stop()
  }
}
